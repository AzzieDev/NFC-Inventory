{
    "name": "azziedevelopment/nfc-recipe-organizer",
    "description": "Lightweight, zero-bloat, open-source PHP web application for managing recipes and dynamically linking them to physical NFC tags.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "altorouter/altorouter": "^2.0",
        "zircote/swagger-php": "^4.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox"
    }
}
